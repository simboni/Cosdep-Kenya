# Copy this file to ".env" and fill in your details:
#
#   cp .env.example .env
#   nano .env
#   docker compose up -d --build
#
# ---------------------------------------------------------------------------
# Your domain(s). Caddy automatically gets a free HTTPS certificate for these
# from Let's Encrypt. Space-separate multiple names (e.g. apex + www).
SITE_ADDRESS=cosdepkenya.org www.cosdepkenya.org

# ---------------------------------------------------------------------------
# Testing on a bare IP before your domain's DNS is ready? Comment the line
# above and uncomment this one instead (plain HTTP, no certificate):
# SITE_ADDRESS=:80
