# Caddy configuration for the COSDEP static site.
# Caddy obtains and renews a free Let's Encrypt certificate automatically —
# there is nothing else to configure for HTTPS.

# SITE_ADDRESS decides how the site is served (set in .env):
#   cosdepkenya.org www.cosdepkenya.org  → automatic HTTPS for those domains
#   :80                                   → plain HTTP, for testing on a bare IP
#
# No inline default here: Caddy's default syntax is {$VAR:default}, so a shell
# style {$VAR:-:80} is read as the literal hostname "-", which matches nothing
# and makes every request return an empty 200. The Dockerfile sets ENV
# SITE_ADDRESS=:80 as the baseline instead, and compose overrides it from .env.
{$SITE_ADDRESS} {
	root * /srv
	encode zstd gzip

	# The site is exported with trailingSlash, so every route is already a folder
	# containing an index.html. file_server resolves those directly (and redirects
	# /about to /about/), so no try_files rewriting is needed — adding one makes
	# the bare "/" request resolve to the directory itself and return an empty body.
	file_server {
		index index.html
	}

	# Serve the exported 404 page for unknown routes.
	handle_errors {
		rewrite * /404.html
		file_server
	}

	# Security headers (mirrors the previous Render configuration).
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
	}

	# Hashed build assets never change — cache them aggressively.
	@immutable path /_next/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
}
